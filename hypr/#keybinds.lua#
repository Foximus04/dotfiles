local function launch(name, opts)
	local program = name or {}
	local opts = opts or {}

	if opts.focus == true then
		for _, w in ipairs(hl.get_windows() or {}) do
			if w.class and string.lower(w.class) == string.lower(name) then
				hl.dispatch(hl.dsp.focus({ window = w }))
				return
			end
		end
	end

	if opts.tui == true then
		program = "kitty --app-id=" .. name .. " -e " .. name
	end

	hl.dispatch(hl.dsp.exec_cmd(program, opts.rules))
end

local function send_shortcut_once(mods, key)
	return function()
		hl.dispatch(hl.dsp.send_key_state({ mods = mods, key = key, state = "down", window = "activewindow" }))

		hl.timer(function()
			hl.dispatch(hl.dsp.send_key_state({ mods = mods, key = key, state = "up", window = "activewindow" }))
		end, { timeout = 50, type = "oneshot" })
	end
end

local function web_shortcut(url)
  if hl.get_active_window().class == "firefox" then
	  launch("firefox " .. url)
    return
  end
	launch("firefox --new-window " .. url)
end


